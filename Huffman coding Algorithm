#include <bits/stdc++.h>
using namespace std;


struct MinHeapNode
{
    char data;
    int freq;
    MinHeapNode *left, *right;

    MinHeapNode(char data, int freq)
    {
        left = right = NULL;
        this->data = data;
        this->freq = freq;
    }
};


struct compare
{
    bool operator()(MinHeapNode* l, MinHeapNode* r)
    {
        return l->freq > r->freq; // smaller frequency = higher priority
    }
};

priority_queue<MinHeapNode*, vector<MinHeapNode*>, compare> minHeap;
map<char, int> freq;   
map<char, string> codes; 

void calcFreq(const string& str)
{
    for (char c : str)
        freq[c]++;
}



void storeCodes(MinHeapNode* root, string str)
{
    if (root == NULL)
        return;
    if (!root->left && !root->right)
        codes[root->data] = str;
    storeCodes(root->left, str + "0");
    storeCodes(root->right, str + "1");
}


void HuffmanCodes()
{
    for (auto& v : freq)
        minHeap.push(new MinHeapNode(v.first, v.second));

    while (minHeap.size() != 1)
    {
        MinHeapNode* left = minHeap.top();
        minHeap.pop();
        MinHeapNode* right = minHeap.top();
        minHeap.pop();

        MinHeapNode* top = new MinHeapNode('$', left->freq + right->freq);
        top->left = left;
        top->right = right;
        minHeap.push(top);
    }
    storeCodes(minHeap.top(), "");

    // Edge case: only one distinct character -> give it code "0"
    if (codes.size() == 1)
        codes.begin()->second = "0";
}


string decode(MinHeapNode* root, const string& s)
{
    string ans = "";

    
    if (!root->left && !root->right)
    {
        return string(s.size(), root->data);
    }

    MinHeapNode* curr = root;
    for (char bit : s)
    {
        curr = (bit == '0') ? curr->left : curr->right;
        if (!curr->left && !curr->right) // reached a leaf
        {
            ans += curr->data;
            curr = root;
        }
    }
    return ans;
}


int main()
{
    string str;
    cout << "Enter the string to encode: ";
    getline(cin, str); 

    if (str.empty())
    {
        cout << "Empty string, nothing to encode.\n";
        return 0;
    }

    calcFreq(str);
    HuffmanCodes();

    cout << "\nCharacter  Frequency  Code\n";
    for (auto& v : codes)
    {
        string shown = (v.first == ' ') ? "' '" : string(1, v.first);
        cout << shown << "          " << freq[v.first] << "          " << v.second << "\n";
    }

    string encodedString;
    for (char c : str)
        encodedString += codes[c];

    cout << "\nEncoded Huffman data:\n" << encodedString << "\n";

    string decodedString = decode(minHeap.top(), encodedString);
    cout << "\nDecoded Huffman data:\n" << decodedString << "\n";

    cout << "\nOriginal size : " << str.size() * 8 << " bits\n";
    cout << "Encoded size  : " << encodedString.size() << " bits\n";
    return 0;
}
